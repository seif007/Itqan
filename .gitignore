# ============================================================================
# Itqan — Tajweed TajweedNet Android app + training pipeline
# ============================================================================

# ----------------------------------------------------------------------------
# Android / Gradle build outputs
# ----------------------------------------------------------------------------
**/build/
.gradle/
.kotlin/
*.apk
*.aab
*.aar
# Exception: vendored prebuilt AARs that ship inside the APK (Sherpa-ONNX JNI
# bridge + ONNX Runtime). Without this the source repo can't reproduce a build
# offline and developers would have to fetch the AAR separately.
!app/libs/*.aar
*.dex
*.ap_

# Local machine configuration & secrets — never commit
local.properties
*.keystore
*.jks
signing.properties
.env
!.env.example

# ----------------------------------------------------------------------------
# Logs & one-off diagnostics from development sessions
# ----------------------------------------------------------------------------
*.log
build_log.txt
_build*.log
_parity*.log

# Local work notes / handoff docs — developer-only, never committed.
WORK_NOTES.txt

# One-off probe / signature dumps from PC debugging sessions.
probe_*.txt
eng_*.txt
pipeline_*.txt
build_fails*.txt
nullx/

# ----------------------------------------------------------------------------
# Large bundled STT model assets — local-only (exceed GitHub's 100 MB file
# limit; the original repo never tracked them). The app extracts/downloads
# them on device; see WORK_NOTES.txt locally for where they come from.
# ----------------------------------------------------------------------------
app/src/main/assets/quran_stt/
app/src/main/assets/sherpa_tarteel/
app/src/main/assets/qalun_nemo_manifest.jsonl

# ----------------------------------------------------------------------------
# OS junk
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------------------------------------------------------
# Itqan training pipeline (training/)
# ----------------------------------------------------------------------------
# Python bytecode & tooling caches
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.ipynb

# Training scratch / probe scripts (underscore-prefixed) are developer-only;
# we keep the tree clean by not committing them.
training/src/_*.py

# Datasets, model checkpoints and exported weights are regenerable from the
# raw Tadabur corpus via the scripts in training/src/. They are NOT committed.
training/dataset/
training/dataset_*/
training/dl_cache/
training/phase2_model_backup/
training/model_weights.json
training/*.wav
training/*.npy
training/*.bin
training/*.arrow
training/*.parquet
training/*.pt
training/*.pth
training/*.ckpt
training/*.onnx
training/*.tflite
training/*.safetensors

# DTW-era calibration / reference artifacts kept for history, but superseded
# by per-head thresholds in decisionThresholdForHead() — do not re-commit.
training/calibration.json
training/tajweed_thresholds.json
training/reference_features.json

# ----------------------------------------------------------------------------
# Android Unit-test / instrumentation scratch generated by local runs
# ----------------------------------------------------------------------------
**/fixtures/*.wav
**/fixtures/*.raw
